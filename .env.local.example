# Supabase credentials — Configuration Example
# Copy this file to .env.local and fill in your project values.
# NEVER commit .env.local to version control.

# The public anonymous (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only service role key — NEVER expose this to the browser
# Only use in Next.js Server Actions or API Route Handlers.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
